{
  "name": "zotero-map-papers",
  "version": "1.0.0",
  "description": "Zotero plugin: Map Papers-style similarity graph, prior works and derivative works for any item",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/anurag/zotero-map-papers",
  "scripts": {
    "build": "node scripts/check.mjs && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
